# mBER UI Backend Configuration
# Copy to .env and adjust paths for your system

# Path to the mber-vhh CLI executable
MBER_UI_MBER_CLI_PATH=mber-vhh

# Path to the mber-open repository clone
MBER_UI_MBER_REPO_PATH=/home/ubuntu/mber-open

# Directory to store job data
MBER_UI_JOBS_DIR=./jobs

# Path to model weights directory
MBER_UI_MODEL_WEIGHTS_DIR=/home/ubuntu/mber-open/weights

# Default GPU device
MBER_UI_DEFAULT_GPU_DEVICE=0

# Server
MBER_UI_HOST=0.0.0.0
MBER_UI_PORT=8000
MBER_UI_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
